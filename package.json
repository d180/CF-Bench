{
  "name": "cf-bench",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "tasks",
    "scripts",
    "worker"
  ],
  "scripts": {
    "cf-bench": "tsx scripts/src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p worker/tsconfig.json",
    "worker:dev": "npm --workspace @cf-bench/worker run dev"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
