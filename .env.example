# cf-bench — copy to .env and fill in with your own values.
# .env is gitignored. Never commit real values here.

# Cloudflare
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE_ID=
CF_ZONE_NAME=example.com

# Zero Trust
CF_TEAM_NAME=
CF_TEAM_DOMAIN=your-team.cloudflareaccess.com
ACCESS_ALLOWED_EMAIL_DOMAIN=example.edu

# Origin — the web server Cloudflare proxies to.
ORIGIN_A_IP=

# WAF task: the one address allowed to reach /admin.
# Must NOT be the machine that runs the grader, or the block is unobservable.
ADMIN_ALLOWED_IP=

# Coasty (phase e — leave blank to use the cookbook's offline mock server)
COASTY_API_KEY=
COASTY_BASE_URL=http://127.0.0.1:8787/v1

# browser-use agent (local). Routed through OpenRouter.
OPENROUTER_API_KEY=
BROWSER_USE_MODEL=anthropic/claude-opus-5
