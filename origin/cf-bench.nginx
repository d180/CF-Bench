# ---------------------------------------------------------------------------
# cf-bench origin
#
# Two deployments live on this one box, on two addresses:
#   IPv4 34.28.27.25            -> deployment A, the CURRENT release
#   IPv6 2600:1900:4000:82d::   -> deployment B, the OLD release, not yet
#                                  decommissioned
#
# Cloudflare sends the same Host header whichever one it connects to, so the
# address is the only thing distinguishing them. That is what makes "a 200 does
# not prove you reached the right server" a real condition rather than a claim.
# ---------------------------------------------------------------------------

# Port 80 forces HTTPS on both addresses. With the zone on Flexible, Cloudflare
# fetches over HTTP, gets this redirect, and loops - task 01's whole premise.
server {
    listen 80 default_server;
    listen [2600:1900:4000:82d::]:80 default_server;
    server_name _;
    return 301 https://$host$request_uri;
}

# --- Main site: apex + www -------------------------------------------------
server {
    listen 443 ssl default_server;
    server_name promptsuggestionmcp.com www.promptsuggestionmcp.com;

    ssl_certificate     /etc/ssl/cloudflare/origin.pem;
    ssl_certificate_key /etc/ssl/cloudflare/origin.key;

    add_header X-CFBench-Site "main" always;

    root /var/www/cf-bench/site;
    index index.html;

    location = /api/time {
        default_type application/json;
        add_header Cache-Control "no-store, must-revalidate" always;
        return 200 '{"origin":"A","now":"$time_iso8601","epoch":"$msec"}\n';
    }

    location /admin {
        default_type text/html;
        return 200 '<!doctype html><title>Admin</title><h1>Admin panel</h1>\n';
    }

    location / { try_files $uri $uri/ =404; }
}

# --- Staging ---------------------------------------------------------------
server {
    listen 443 ssl;
    server_name staging.promptsuggestionmcp.com;
    ssl_certificate     /etc/ssl/cloudflare/origin.pem;
    ssl_certificate_key /etc/ssl/cloudflare/origin.key;
    add_header X-CFBench-Site "staging" always;
    default_type text/html;
    return 200 '<!doctype html><title>Staging</title><h1>cf-bench staging</h1>\n';
}

# --- api on deployment A (IPv4): the current release ------------------------
server {
    listen 443 ssl;
    server_name api.promptsuggestionmcp.com;

    ssl_certificate     /etc/ssl/cloudflare/origin.pem;
    ssl_certificate_key /etc/ssl/cloudflare/origin.key;

    add_header X-CFBench-Origin "A" always;
    add_header X-CFBench-Release "2026.09.27" always;

    location = /health {
        default_type application/json;
        return 200 '{"status":"ok","origin":"A","release":"2026.09.27"}\n';
    }

    # Changing on every request, and explicitly not cacheable, so a stale
    # response is unambiguous rather than a judgement call.
    location = /api/time {
        default_type application/json;
        add_header Cache-Control "no-store, must-revalidate" always;
        return 200 '{"origin":"A","now":"$time_iso8601","epoch":"$msec"}\n';
    }

    location /api/ {
        default_type application/json;
        add_header Cache-Control "no-store, must-revalidate" always;
        return 200 '{"origin":"A","path":"$uri","epoch":"$msec"}\n';
    }

    # 200 normally, so an edge block (403) is distinguishable from a 404.
    location /admin {
        default_type text/html;
        return 200 '<!doctype html><title>API admin</title><h1>API admin</h1>\n';
    }

    location / {
        default_type application/json;
        return 200 '{"origin":"A","service":"api","release":"2026.09.27"}\n';
    }
}

# --- api on deployment B (IPv6): the old release, still running -------------
# default_server for this address, so any Host that lands here is answered by
# the old deployment - which is exactly how a half-finished cutover behaves.
server {
    listen [2600:1900:4000:82d::]:443 ssl default_server;
    server_name _;

    ssl_certificate     /etc/ssl/cloudflare/origin.pem;
    ssl_certificate_key /etc/ssl/cloudflare/origin.key;

    add_header X-CFBench-Origin "B" always;
    add_header X-CFBench-Release "2026.08.02" always;

    location = /health {
        default_type application/json;
        return 200 '{"status":"ok","origin":"B","release":"2026.08.02"}\n';
    }

    location /api/ {
        default_type application/json;
        return 200 '{"origin":"B","path":"$uri","release":"2026.08.02"}\n';
    }

    location /admin {
        default_type text/html;
        return 200 '<!doctype html><title>API admin</title><h1>API admin (old)</h1>\n';
    }

    location / {
        default_type application/json;
        return 200 '{"origin":"B","service":"api","release":"2026.08.02"}\n';
    }
}
